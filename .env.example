# --- apps/api ---
PORT=3000
# Valores para dev desde el host (slots del portfolio: Postgres 5435, Redis 6382).
# Dentro del compose la api usa los defaults de la red interna (db:5432, redis:6379).
DATABASE_URL=postgresql://dashboard:dashboard@localhost:5435/dashboard
REDIS_URL=redis://localhost:6382
# Dentro del compose: http://prometheus:9090 (sin puerto publicado en el host).
PROMETHEUS_URL=http://prometheus:9090
# Socket de Docker (montado read-only en el contenedor del api).
DOCKER_SOCKET=/var/run/docker.sock
# gid del grupo dueño del socket: 0 en Docker Desktop, gid de `docker` en Linux.
DOCKER_GROUP_GID=0
# Limitar el inventario a ciertos proyectos de compose (separados por coma).
# Vacío = todos los contenedores levantados por compose.
COMPOSE_PROJECTS=

# --- Integraciones del ecosistema CCI (red compartida cci-net) ---
# Validación de JWT: claves públicas RS256 de cci-auth-service, iss verificado.
AUTH_SERVICE_URL=http://cci-auth-service:3000
AUTH_JWKS_URL=http://cci-auth-service:3000/.well-known/jwks.json
AUTH_ISSUER=https://auth.corecodeinnovation.com
# Solo dev/tests sin auth-service desplegado: valida HS256 con este secreto.
AUTH_JWT_SECRET=
# Orígenes permitidos para el WS/REST (separados por coma).
CORS_ORIGIN=http://localhost:3002
# Jobs pesados (reportes demo).
TASKFORGE_URL=http://taskforge:3000
# Alertas (caída/restart de contenedores → Telegram).
NOTIFY_BOT_URL=http://ops-notify-bot:3001
# Secreto compartido del webhook de ops-notify-bot (X-Webhook-Secret).
# Debe coincidir con WEBHOOK_SECRET del .env de ops-notify-bot.
NOTIFY_BOT_WEBHOOK_SECRET=

# --- apps/web ---
# URL del gateway WS vista desde el BROWSER (se inyecta en BUILD de Next).
# Demo local: http://localhost:3004. En el host del túnel: dejarla VACÍA
# (mismo origen; cloudflared rutea dash.corecodeinnovation.com/socket.io/* → 3004).
NEXT_PUBLIC_API_WS_URL=http://localhost:3004

# --- docker-compose (Postgres) ---
POSTGRES_USER=dashboard
POSTGRES_PASSWORD=dashboard
POSTGRES_DB=dashboard
