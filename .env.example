# --- apps/api ---
PORT=3000
# Valores para dev desde el host (slots del portfolio: Postgres 5435, Redis 6382).
# Dentro del compose la api usa los defaults de la red interna (db:5432, redis:6379).
DATABASE_URL=postgresql://dashboard:dashboard@localhost:5435/dashboard
REDIS_URL=redis://localhost:6382
# Dentro del compose: http://prometheus:9090 (sin puerto publicado en el host).
PROMETHEUS_URL=http://prometheus:9090

# Integraciones del ecosistema CCI (dentro de la red compartida cci-net).
AUTH_SERVICE_URL=http://cci-auth-service:3000
TASKFORGE_URL=http://taskforge:3000

# --- docker-compose (Postgres) ---
POSTGRES_USER=dashboard
POSTGRES_PASSWORD=dashboard
POSTGRES_DB=dashboard
